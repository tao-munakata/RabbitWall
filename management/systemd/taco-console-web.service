[Unit]
Description=TACO loopback-only web console
Requires=taco-console-collector.service
Wants=taco-console-control.service
After=taco-console-collector.service taco-console-control.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/taco-console/console.py serve
DynamicUser=yes
SupplementaryGroups=taco-console-control
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/taco-console
MemoryMax=96M

[Install]
WantedBy=multi-user.target
