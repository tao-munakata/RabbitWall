[Unit]
Description=Radxa AI DNS forwarder and domain observations
After=network-online.target nftables.service taco-console-control.service
Wants=network-online.target
Requires=taco-console-control.service

[Service]
Type=simple
User=taco-console-dns
Group=taco-console-dns
RuntimeDirectory=taco-console-dns
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 -B /opt/taco-console/dns_forwarder.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/run/taco-console-dns
UMask=0027
MemoryMax=128M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
