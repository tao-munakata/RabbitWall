config interface 'ai_transit'
        option device 'lan4'
        option proto 'static'
        option ipaddr '10.2.0.1'
        option netmask '255.255.255.252'
        option delegate '0'

config route 'ai_subnet'
        option interface 'ai_transit'
        option target '10.1.0.0/24'
        option gateway '10.2.0.2'
