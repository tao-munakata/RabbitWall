config zone 'ai_zone'
        option name 'ai'
        list network 'ai_transit'
        option input 'REJECT'
        option output 'ACCEPT'
        option forward 'REJECT'
        option masq '0'

config rule 'ai_dns'
        option name 'AI DNS to designated resolver'
        option src 'ai'
        option family 'ipv4'
        list src_ip '10.1.0.0/24'
        list src_ip '10.2.0.2/32'
        option dest_ip '10.0.0.254'
        option proto 'tcp udp'
        option dest_port '53'
        option target 'ACCEPT'

config rule 'ai_transit_ping'
        option name 'RPi ping transit gateway'
        option src 'ai'
        option family 'ipv4'
        option src_ip '10.2.0.2'
        option dest_ip '10.2.0.1'
        option proto 'icmp'
        option icmp_type 'echo-request'
        option target 'ACCEPT'

config rule 'ai_admin_ssh'
        option name 'Management PC SSH to RPi and Spark'
        option src 'lan'
        option dest 'ai'
        option family 'ipv4'
        option src_ip '10.0.0.10'
        list dest_ip '10.2.0.2'
        list dest_ip '10.1.0.10'
        option proto 'tcp'
        option dest_port '22'
        option target 'ACCEPT'

config rule 'ai_admin_ping'
        option name 'Management PC ping RPi and Spark'
        option src 'lan'
        option dest 'ai'
        option family 'ipv4'
        option src_ip '10.0.0.10'
        list dest_ip '10.2.0.2'
        list dest_ip '10.1.0.10'
        option proto 'icmp'
        option icmp_type 'echo-request'
        option target 'ACCEPT'

config rule 'ai_block_special'
        option name 'AI reject non-public forwarded destinations'
        option src 'ai'
        option dest '*'
        option family 'ipv4'
        list dest_ip '0.0.0.0/8'
        list dest_ip '10.0.0.0/8'
        list dest_ip '100.64.0.0/10'
        list dest_ip '127.0.0.0/8'
        list dest_ip '169.254.0.0/16'
        list dest_ip '172.16.0.0/12'
        list dest_ip '192.0.0.0/24'
        list dest_ip '192.0.2.0/24'
        list dest_ip '192.168.0.0/16'
        list dest_ip '198.18.0.0/15'
        list dest_ip '198.51.100.0/24'
        list dest_ip '203.0.113.0/24'
        list dest_ip '224.0.0.0/4'
        list dest_ip '240.0.0.0/4'
        option proto 'all'
        option target 'REJECT'

config rule 'ai_web'
        option name 'AI public HTTP HTTPS'
        option src 'ai'
        option dest 'wan'
        option family 'ipv4'
        list src_ip '10.1.0.0/24'
        list src_ip '10.2.0.2/32'
        option proto 'tcp'
        option dest_port '80 443'
        option target 'ACCEPT'

config rule 'ai_ntp'
        option name 'AI public NTP'
        option src 'ai'
        option dest 'wan'
        option family 'ipv4'
        list src_ip '10.1.0.0/24'
        list src_ip '10.2.0.2/32'
        option proto 'udp'
        option dest_port '123'
        option target 'ACCEPT'
