[Unit]
Description=RABBITWALL loopback-only web console
Requires=rabbitwall-collector.service
Wants=rabbitwall-control.service
After=rabbitwall-collector.service rabbitwall-control.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/rabbitwall/console.py serve
DynamicUser=yes
SupplementaryGroups=rabbitwall-control rabbitwall-read
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/rabbitwall
MemoryMax=96M

[Install]
WantedBy=multi-user.target
