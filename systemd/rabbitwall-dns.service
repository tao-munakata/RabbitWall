[Unit]
Description=RabbitWall Unbound DNS forwarder
After=network-online.target nftables.service rabbitwall-control.service
Wants=network-online.target
Requires=rabbitwall-control.service

[Service]
Type=simple
User=rabbitwall-dns
Group=rabbitwall-dns
RuntimeDirectory=rabbitwall-dns
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/sbin/unbound -d -c /etc/rabbitwall-unbound.conf
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# getifaddrs() enumerates interfaces through NETLINK_ROUTE on Linux.
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
UMask=0027
MemoryMax=192M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
