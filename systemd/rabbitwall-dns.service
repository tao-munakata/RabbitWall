[Unit]
Description=RabbitWall AI DNS forwarder and domain observations
After=network-online.target nftables.service rabbitwall-control.service
Wants=network-online.target
Requires=rabbitwall-control.service

[Service]
Type=simple
User=rabbitwall-dns
Group=rabbitwall-dns
RuntimeDirectory=rabbitwall-dns
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 -B /opt/rabbitwall/dns_forwarder.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/run/rabbitwall-dns
UMask=0027
MemoryMax=128M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
