[Unit]
Description=RABBITWALL management-PC-only mTLS endpoint
Wants=network-online.target
After=network-online.target rabbitwall-web.service
Requires=rabbitwall-web.service

[Service]
Type=simple
User=caddy
Group=caddy
EnvironmentFile=/etc/rabbitwall-mtls/control.env
ExecStartPre=/usr/bin/caddy validate --config /etc/rabbitwall-mtls/Caddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --config /etc/rabbitwall-mtls/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
StateDirectory=rabbitwall-caddy
Environment=XDG_DATA_HOME=/var/lib/rabbitwall-caddy
Environment=XDG_CONFIG_HOME=/var/lib/rabbitwall-caddy
MemoryMax=256M

[Install]
WantedBy=multi-user.target
